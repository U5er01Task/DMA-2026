<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FirstApps" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorSecondary">@color/brand_green</item>
    </style>

    <!-- Заголовок раздела на экранах -->
    <style name="ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Поле ввода на всю ширину -->
    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- Кнопка на всю ширину -->
    <style name="WideButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Текст результата -->
    <style name="ResultText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
