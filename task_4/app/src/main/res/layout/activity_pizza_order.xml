<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/pizza_title" />

        <RadioGroup
            android:id="@+id/radioSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pizza_small" />

            <RadioButton
                android:id="@+id/radioMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pizza_medium" />

            <RadioButton
                android:id="@+id/radioLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pizza_large" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/checkCheese"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/pizza_cheese" />

        <EditText
            android:id="@+id/editCount"
            style="@style/FormField"
            android:hint="@string/pizza_hint_count"
            android:importantForAutofill="no"
            android:inputType="number"
            android:text="@string/default_count" />

        <EditText
            android:id="@+id/editAddress"
            style="@style/FormField"
            android:autofillHints="postalAddress"
            android:hint="@string/pizza_hint_address"
            android:inputType="textPostalAddress" />

        <Button
            android:id="@+id/buttonOrder"
            style="@style/WideButton"
            android:text="@string/pizza_order" />
    </LinearLayout>
</ScrollView>
