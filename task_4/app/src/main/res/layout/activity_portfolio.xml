<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- "Фотография": векторная иконка вместо реального фото (публичный репозиторий) -->
    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/portfolio_name"
        android:src="@drawable/ic_person" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/portfolio_name"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/portfolio_role"
        android:textColor="@color/text_secondary" />

    <Button
        android:id="@+id/buttonAbout"
        style="@style/WideButton"
        android:text="@string/portfolio_about" />

    <Button
        android:id="@+id/buttonSkills"
        style="@style/WideButton"
        android:text="@string/portfolio_skills" />

    <Button
        android:id="@+id/buttonContacts"
        style="@style/WideButton"
        android:text="@string/portfolio_contacts" />
</LinearLayout>
