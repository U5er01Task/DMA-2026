<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/ScreenTitle"
        android:text="@string/tips_title"
        android:textSize="26sp" />

    <EditText
        android:id="@+id/etTotalBill"
        style="@style/FormField"
        android:hint="@string/tips_hint_bill"
        android:importantForAutofill="no"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etPersonsCount"
        style="@style/FormField"
        android:hint="@string/tips_hint_persons"
        android:importantForAutofill="no"
        android:inputType="number" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/tips_calculate" />

    <TextView
        android:id="@+id/tvTipAmount"
        style="@style/ResultText" />

    <TextView
        android:id="@+id/tvPerPerson"
        style="@style/ResultText"
        android:layout_marginTop="8dp"
        android:textColor="@color/teal"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
