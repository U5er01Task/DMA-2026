<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 2, задание 5. Large Heap для графического редактора

    largeHeap="true" поднимает лимит кучи Dalvik/ART (например, с 256 до 512 МБ).

    Риски:
      1. Размер не гарантирован - на слабых устройствах лимит может почти не вырасти.
      2. Большая куча = дольше сборка мусора (GC), появляются подвисания интерфейса.
      3. Приложение в фоне с большой кучей система убьет первым (Low Memory Killer).
      4. Скрывает утечки памяти вместо того, чтобы их исправлять.
    Лучше: грузить картинки уменьшенными (inSampleSize), использовать Glide/Coil, освобождать Bitmap.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:largeHeap="true"
        android:hardwareAccelerated="true" />

</manifest>
