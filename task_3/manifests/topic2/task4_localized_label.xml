<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 2, задание 4. Локализация названия приложения

    Название берется из ресурса @string/app_name:
      res/values/strings.xml    -> "Manifest Lab"
      res/values-ru/strings.xml -> "Лаба по манифесту"
    Система сама выбирает перевод по языку устройства или по языку приложения
    (Android 13+, список языков в localeConfig).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:localeConfig="@xml/locales_config" />

</manifest>
