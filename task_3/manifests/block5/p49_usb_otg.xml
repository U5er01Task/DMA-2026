<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 49. Автозапуск при подключении USB-устройства (OTG)

    При подключении устройства из res/xml/device_filter.xml Android предложит открыть приложение,
    и разрешение на доступ к USB будет выдано автоматически.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".usb.UsbDeviceActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

    </application>

</manifest>
