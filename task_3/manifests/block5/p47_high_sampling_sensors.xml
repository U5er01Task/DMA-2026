<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 47. Высокая частота опроса сенсоров

    С Android 12 частота гироскопа/акселерометра без разрешения ограничена 200 Гц.
    HIGH_SAMPLING_RATE_SENSORS (normal) снимает ограничение - нужно для гоночной игры.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:isGame="true" />

</manifest>
