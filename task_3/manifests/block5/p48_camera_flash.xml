<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 48. Фонарик (вспышка) - необязательно

    Фонарик включается через CameraManager.setTorchMode() - разрешение CAMERA для этого не нужно.
    Вспышка необязательна: на устройствах без нее просто скрываем кнопку.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App" />

</manifest>
