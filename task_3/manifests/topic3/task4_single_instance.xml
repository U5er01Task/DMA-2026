<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 3, задание 4. Экран звонка с launchMode="singleInstance"

    singleInstance - Activity живет одна в своей отдельной задаче (task).
    Повторный входящий звонок не создаст второй экран, а придет в onNewIntent().
    showWhenLocked / turnScreenOn - показать экран поверх блокировки и включить дисплей.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".call.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

    </application>

</manifest>
