<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 3, задание 5. FileProvider для камеры

    Камера получает content://ru.kulikov.pr3.fileprovider/camera_photos/IMG.jpg
    и временное право записи (FLAG_GRANT_WRITE_URI_PERMISSION).
    exported="false" + grantUriPermissions="true" - доступ только по выданному разрешению.
    Папки описаны в res/xml/file_paths.xml.
    ${applicationId} подставляет Gradle при сборке (здесь для проверки через aapt2 он остается строкой).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
