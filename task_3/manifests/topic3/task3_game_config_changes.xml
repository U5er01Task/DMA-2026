<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 3, задание 3. Блокировка пересоздания при повороте

    При повороте Activity по умолчанию пересоздается. Для игры это плохо (теряется кадр, OpenGL-контекст),
    поэтому изменения конфигурации обрабатываем сами в onConfigurationChanged().
    screenSize нужен начиная с API 13, иначе поворот все равно пересоздаст экран.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>
