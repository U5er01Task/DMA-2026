<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 3, задание 1. Стартовая Activity

    Только у SplashScreenActivity есть MAIN + LAUNCHER, поэтому в лаунчере будет одна иконка.
    exported="true" обязателен (Android 12+), т.к. есть intent-filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

    </application>

</manifest>
