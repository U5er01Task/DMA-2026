<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 5, задание 3. Собственное разрешение уровня signature

    protectionLevel="signature" - разрешение автоматически выдается только приложениям,
    подписанным тем же ключом. Чужие приложения не смогут привязаться к сервису.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <permission
        android:name="ru.kulikov.pr3.permission.BIND_SYNC_SERVICE"
        android:label="@string/app_name"
        android:protectionLevel="signature" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".sync.PartnerSyncService"
            android:exported="true"
            android:permission="ru.kulikov.pr3.permission.BIND_SYNC_SERVICE">
            <intent-filter>
                <action android:name="ru.kulikov.pr3.action.SYNC" />
            </intent-filter>
        </service>

    </application>

</manifest>
