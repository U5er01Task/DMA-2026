<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 4, задание 3. Диплинк с маской пути (только PDF)

    В XML точку экранируем двойным обратным слэшем: .*\\.pdf
    pathPattern работает только вместе с scheme и host.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".docs.PdfViewerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="docs.university.ru" />
                <data android:pathPattern=".*\\.pdf" />
            </intent-filter>
        </activity>

    </application>

</manifest>
