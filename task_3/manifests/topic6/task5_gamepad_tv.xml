<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 6, задание 5. Поддержка геймпадов для Android TV

    android.hardware.gamepad         - поддержка геймпада (необязательна, можно играть с пульта)
    android.software.leanback        - версия для Android TV (необязательна, чтобы ставилось и на телефоны)
    android.hardware.touchscreen=false - на телевизоре нет сенсорного экрана
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:isGame="true"
        android:banner="@drawable/tv_banner" />

</manifest>
