<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 6, задание 1. Необязательный сканер отпечатка

    required="false" - Google Play покажет приложение и на устройствах без сканера.
    Наличие сканера проверяем в коде через BiometricManager.canAuthenticate().
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App" />

</manifest>
