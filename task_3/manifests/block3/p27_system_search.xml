<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 27. Обработка системного поиска (ACTION_SEARCH)

    Запрос приходит в intent.getStringExtra(SearchManager.QUERY).
    singleTop - повторный поиск на этом же экране придет в onNewIntent().
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".search.SearchResultsActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

    </application>

</manifest>
