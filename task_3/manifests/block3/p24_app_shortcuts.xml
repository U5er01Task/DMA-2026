<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 24. Шорткаты и Google Assistant (App Actions)

    Файл res/xml/shortcuts.xml: статический шорткат "Заказать еду" и capability
    actions.intent.ORDER_MENU_ITEM для голосовой команды Ассистента.
    meta-data ставится у стартовой Activity (с MAIN/LAUNCHER).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.OrderActivity"
            android:exported="true" />

    </application>

</manifest>
