<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 22. Открытие геопозиции (geo:0,0?q=)

    Ссылка geo:0,0?q=Москва, Красная площадь или geo:55.75,37.61 откроется в нашей карте.
    Параметры после "?" в фильтре не указываются - их разбираем из intent.data в коде.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".map.MapActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

    </application>

</manifest>
