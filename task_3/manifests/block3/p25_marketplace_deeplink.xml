<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 25. Диплинк интернет-магазина с верификацией домена

    Ссылка https://marketplace.com/catalog/shoes?brand=nike
    Query-параметры (?brand=nike) в фильтре не задаются - читаем intent.data.getQueryParameter("brand").
    autoVerify - проверка через https://marketplace.com/.well-known/assetlinks.json (и для www тоже).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".catalog.CatalogActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="marketplace.com" />
                <data android:host="www.marketplace.com" />
                <data android:pathPrefix="/catalog/" />
            </intent-filter>
        </activity>

    </application>

</manifest>
