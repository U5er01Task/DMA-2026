<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 21. Перехват карты Mifare (TECH_DISCOVERED)

    TECH_DISCOVERED срабатывает, если технологии метки совпадают с одним из tech-list
    в res/xml/nfc_tech_filter.xml (NfcA + MifareClassic или NfcA + MifareUltralight).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".nfc.CardReaderActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

    </application>

</manifest>
