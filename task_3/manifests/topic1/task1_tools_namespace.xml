<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 1, задание 1. Декларация пространств имен

    xmlns:android - атрибуты платформы (android:name, android:label ...)
    xmlns:tools   - директивы для сборщика (Manifest Merger) и Lint.
                   В итоговый APK атрибуты tools:* не попадают.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        tools:ignore="GoogleAppIndexingWarning" />

</manifest>
