<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 5. Картинка в картинке (PiP)

    При переходе в PiP меняется размер окна - чтобы видео не перезапускалось,
    обрабатываем смену конфигурации сами (configChanges).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".player.VideoPlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />

    </application>

</manifest>
