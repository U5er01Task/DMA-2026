<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 2. Activity без иконки в лаунчере

    Нет категории LAUNCHER - значит нет иконки в списке приложений.
    Экран открывается только из других приложений через свой action.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".api.ExternalPaymentActivity"
            android:exported="true"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="ru.kulikov.pr3.action.PAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
