<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 10. Кастомный TestInstrumentationRunner

    Обычно раннер указывают в build.gradle (testInstrumentationRunner), и Gradle сам
    генерирует этот тег в манифесте тестового APK. Здесь он объявлен вручную.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <instrumentation
        android:name="ru.kulikov.pr3.test.CustomTestRunner"
        android:targetPackage="ru.kulikov.pr3"
        android:label="@string/tests_label"
        android:functionalTest="false"
        android:handleProfiling="false" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App" />

</manifest>
