<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 4. Новогодняя иконка через activity-alias

    Два алиаса на одну MainActivity. Включен обычный, новогодний выключен.
    Переключение в коде:
      packageManager.setComponentEnabledSetting(
          ComponentName(context, "ru.kulikov.pr3.LauncherNewYear"),
          COMPONENT_ENABLED_STATE_ENABLED, DONT_KILL_APP)
    и обычный алиас - в DISABLED.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".ui.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNewYear"
            android:targetActivity=".ui.MainActivity"
            android:icon="@mipmap/ic_launcher_newyear"
            android:label="@string/app_name_newyear"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
