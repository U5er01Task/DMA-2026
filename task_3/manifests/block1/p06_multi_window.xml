<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 6. Минимальный размер окна в многооконном режиме

    <layout> задает размер окна в режиме свободных окон (freeform) и минимальный размер при split-screen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.NotesActivity"
            android:exported="false"
            android:resizeableActivity="true">
            <layout
                android:defaultWidth="600dp"
                android:defaultHeight="500dp"
                android:gravity="top|end"
                android:minWidth="300dp"
                android:minHeight="450dp" />
        </activity>

    </application>

</manifest>
