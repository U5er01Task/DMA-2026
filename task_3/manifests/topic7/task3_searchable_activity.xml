<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 7, задание 3. Метаданные поиска у SearchActivity

    android.app.searchable привязывается именно к экрану поиска.
    default_searchable у Application - любой экран будет отправлять поиск в SearchActivity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <meta-data
            android:name="android.app.default_searchable"
            android:value=".search.SearchActivity" />

        <activity
            android:name=".search.SearchActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

    </application>

</manifest>
