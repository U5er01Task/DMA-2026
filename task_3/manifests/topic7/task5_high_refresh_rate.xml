<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема 7, задание 5. Частота обновления экрана 120 Гц

    Честно: стандартного meta-data для 120 Гц в Android нет. Частоту выбирает система,
    а приложение может попросить нужную в коде:
      window.attributes.preferredRefreshRate = 120f   (или preferredDisplayModeId)
    Поэтому сделал свой ключ в метаданных Activity, который читается в onCreate() и
    передается в WindowManager.LayoutParams. Так частоту можно менять без правки кода.
    Отдельно для игр Android 11+ поддерживает android:preferMinimalPostProcessing
    (режим "игра" на ТВ/мониторах с минимальной задержкой).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:preferMinimalPostProcessing="true"
            android:hardwareAccelerated="true">
            <meta-data
                android:name="ru.kulikov.pr3.PREFERRED_REFRESH_RATE"
                android:value="120" />
        </activity>

    </application>

</manifest>
