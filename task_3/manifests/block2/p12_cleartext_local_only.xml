<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 12. HTTP только для локального сервера 192.168.1.50

    Конфиг: res/xml/network_security_config_dev.xml.
    usesCleartextTraffic не указываем: при наличии networkSecurityConfig он игнорируется.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:networkSecurityConfig="@xml/network_security_config_dev" />

</manifest>
