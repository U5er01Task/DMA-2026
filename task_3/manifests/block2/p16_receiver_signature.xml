<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 16. Защита BroadcastReceiver разрешением signature

    exported="false" - системные и чужие broadcast'ы до ресивера не дойдут.
    android:permission - дополнительно отправитель обязан иметь наше signature-разрешение
    (нужно, если ресивер когда-нибудь станет exported или получит broadcast от своего второго приложения).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <permission
        android:name="ru.kulikov.pr3.permission.SEND_INTERNAL_EVENTS"
        android:protectionLevel="signature" />

    <uses-permission android:name="ru.kulikov.pr3.permission.SEND_INTERNAL_EVENTS" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <receiver
            android:name=".receivers.SessionExpiredReceiver"
            android:exported="false"
            android:permission="ru.kulikov.pr3.permission.SEND_INTERNAL_EVENTS">
            <intent-filter>
                <action android:name="ru.kulikov.pr3.action.SESSION_EXPIRED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
