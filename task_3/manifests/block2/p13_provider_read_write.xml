<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 13. ContentProvider с разными правами на чтение и запись

    Читать может любое приложение с нашим разрешением READ (dangerous - спросит пользователя),
    писать - только наши приложения (signature).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <permission
        android:name="ru.kulikov.pr3.permission.READ_NOTES"
        android:label="@string/app_name"
        android:protectionLevel="dangerous" />
    <permission
        android:name="ru.kulikov.pr3.permission.WRITE_NOTES"
        android:label="@string/app_name"
        android:protectionLevel="signature" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <provider
            android:name=".data.NotesProvider"
            android:authorities="ru.kulikov.pr3.notes"
            android:exported="true"
            android:readPermission="ru.kulikov.pr3.permission.READ_NOTES"
            android:writePermission="ru.kulikov.pr3.permission.WRITE_NOTES" />

    </application>

</manifest>
