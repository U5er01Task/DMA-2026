<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 17. Вызов Activity только с BIND_ACCESSIBILITY_SERVICE

    BIND_ACCESSIBILITY_SERVICE имеет уровень signature платформы - его имеет только система.
    Значит запустить этот экран сможет только системный процесс.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <activity
            android:name=".accessibility.AccessibilitySettingsActivity"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

    </application>

</manifest>
