<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 20. Аудит манифеста (Androbugs) - исправленная версия

    Исходный фрагмент (уязвимый):

        <application android:debuggable="true" android:allowBackup="true">
            <activity android:name=".AdminPanelActivity" android:exported="true" />
            <provider android:name=".UsersProvider"
                      android:authorities="ru.kulikov.pr3.users"
                      android:exported="true" />
            <receiver android:name=".ResetPasswordReceiver" android:exported="true">
                <intent-filter><action android:name="ru.kulikov.pr3.RESET" /></intent-filter>
            </receiver>
        </application>

    Найденные критические уязвимости:
      1. AdminPanelActivity exported="true" без permission - любое приложение
         может открыть админ-панель в обход экрана логина.
      2. UsersProvider exported="true" без read/writePermission - любое приложение
         читает и меняет базу пользователей (утечка данных, SQL-инъекции через selection).
      3. ResetPasswordReceiver exported="true" без permission - чужое приложение
         отправит broadcast и сбросит пароль.
      + debuggable="true" и allowBackup="true" - через adb можно вытащить все данные приложения.

    Ниже исправленная версия.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <permission
        android:name="ru.kulikov.pr3.permission.ADMIN"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App"
        android:allowBackup="false">

        <activity
            android:name=".AdminPanelActivity"
            android:exported="false" />

        <provider
            android:name=".UsersProvider"
            android:authorities="ru.kulikov.pr3.users"
            android:exported="false" />

        <receiver
            android:name=".ResetPasswordReceiver"
            android:exported="true"
            android:permission="ru.kulikov.pr3.permission.ADMIN">
            <intent-filter>
                <action android:name="ru.kulikov.pr3.RESET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
