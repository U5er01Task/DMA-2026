<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 37. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS

    РИСКИ В GOOGLE PLAY:
      - Разрешение позволяет показать системный диалог "Не оптимизировать расход батареи".
      - Google Play разрешает его только приложениям, чья основная функция ломается в Doze:
        мессенджеры с VoIP, трекеры здоровья, приложения для управления устройствами,
        помощь людям с ограниченными возможностями и т.п.
      - Если причина не подходит под исключения - приложение отклоняют или удаляют из Play.
      - Для обычных задач использовать FCM high-priority сообщения, WorkManager и
        setExactAndAllowWhileIdle().
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App" />

</manifest>
