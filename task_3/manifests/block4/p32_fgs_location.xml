<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 32. Foreground Service типа location (курьер)

    Тип location требует ACCESS_COARSE или ACCESS_FINE_LOCATION.
    BACKGROUND_LOCATION нужен, если курьер свернул приложение и трекинг должен продолжаться
    после перезапуска сервиса из фона.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".courier.CourierTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
