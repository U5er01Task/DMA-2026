<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 34. Foreground Service типа mediaProjection (трансляция на ТВ)

    Перед стартом сервиса пользователь подтверждает запись экрана через
    MediaProjectionManager.createScreenCaptureIntent(). Без этого startForeground() упадет.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".cast.ScreenCastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
