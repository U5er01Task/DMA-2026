<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 38. Служба специальных возможностей

    BIND_ACCESSIBILITY_SERVICE - к службе может привязаться только система.
    Пользователь включает службу вручную в Настройки -> Спец. возможности.
    Настройки службы: res/xml/accessibility_service_config.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".accessibility.ScreenReaderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
