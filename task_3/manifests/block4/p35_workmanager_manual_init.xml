<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 35. Отключение автоинициализации WorkManager

    WorkManager инициализируется через androidx.startup. Убираем его инициализатор,
    а в Application реализуем Configuration.Provider (свой пул потоков, уровень логов):
        class MainApplication : Application(), Configuration.Provider {
            override val workManagerConfiguration = Configuration.Builder().build()
        }
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
