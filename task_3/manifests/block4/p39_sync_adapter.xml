<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 39. Служба синхронизации (SyncAdapter)

    Для SyncAdapter нужны три части:
      1. сервис синхронизации (meta-data @xml/syncadapter);
      2. сервис аутентификатора, описывающий тип аккаунта (@xml/authenticator);
      3. ContentProvider с authority из syncadapter.xml (может быть пустой заглушкой).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" android:maxSdkVersion="22" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".sync.SyncService"
            android:exported="true"
            android:process=":sync">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <service
            android:name=".sync.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <provider
            android:name=".sync.StubProvider"
            android:authorities="ru.kulikov.pr3.sync.provider"
            android:exported="false"
            android:syncable="true" />

    </application>

</manifest>
