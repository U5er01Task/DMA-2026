<?xml version="1.0" encoding="utf-8"?>
<!--
    Практика 40. Живые обои (WallpaperService)

    BIND_WALLPAPER - привязаться к службе может только система.
    android.software.live_wallpaper - Google Play не покажет приложение там, где живые обои не поддерживаются.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ru.kulikov.pr3">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.App">

        <service
            android:name=".wallpaper.StarryNightWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>
