<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ (API 31): системный Splash Screen API.
        В библиотеке androidx.core:core-splashscreen это Theme.SplashScreen с атрибутами
        windowSplashScreenBackground / windowSplashScreenAnimatedIcon / postSplashScreenTheme.
        Здесь используются те же атрибуты из самой платформы (без подключения библиотеки).
    -->
    <style name="Theme.App.Starting" parent="Theme.App">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
