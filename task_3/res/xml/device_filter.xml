<?xml version="1.0" encoding="utf-8"?>
<!-- Блок 5, задание 49. USB-устройства, при подключении которых запускается приложение -->
<resources>
    <!-- Arduino Uno (VID 0x2341 = 9025, PID 0x0043 = 67) -->
    <usb-device vendor-id="9025" product-id="67" />
    <!-- любые USB-устройства класса HID (клавиатуры, геймпады) -->
    <usb-device class="3" />
</resources>
