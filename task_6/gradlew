#!/usr/bin/env sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v gradle >/dev/null 2>&1; then exec gradle -p "$HERE" "$@"; fi
DIR="$HERE/.bootstrap-gradle"
ZIP="$DIR/gradle-8.10.2-bin.zip"
EXEC="$DIR/gradle-8.10.2/bin/gradle"
if [ ! -x "$EXEC" ]; then
  mkdir -p "$DIR"
  echo 'Fetching Gradle 8.10.2 from services.gradle.org (requires internet)...' >&2
  curl -fL --retry 3 --output "$ZIP" 'https://services.gradle.org/distributions/gradle-8.10.2-bin.zip'
  HASH=$(sha256sum "$ZIP" | cut -d ' ' -f 1)
  [ "$HASH" = '31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26' ] || { echo 'Gradle archive checksum mismatch' >&2; exit 1; }
  unzip -q -o "$ZIP" -d "$DIR"
fi
exec "$EXEC" -p "$HERE" "$@"
